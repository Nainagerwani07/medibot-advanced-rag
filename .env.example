# Copy to .env and fill in real values. .env is gitignored; never commit it.
#   cp .env.example .env

# Groq LLM inference (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# Qdrant vector DB (started with `docker compose up -d`)
QDRANT_URL=http://localhost:6333

# Dataset location (unzipped mediassist_data, relative to repo root)
DATA_DIR=data/mediassist_data

# JWT signing key for the API (any long random string, e.g. `python3 -c "import secrets;print(secrets.token_urlsafe(32))"`).
# If unset, the API makes a random one per process (tokens stop working after a restart).
MEDIBOT_JWT_SECRET=change-me
